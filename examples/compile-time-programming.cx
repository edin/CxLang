import c.stdio;

compile const generation_enabled: bool = true;

compile fn generated_names() -> list<string> {
    let names: list<string> = [];
    names.add("first");
    names.add("second");
    return names;
}

@if(generation_enabled) {
    @foreach name in generated_names() {
        fn @{as_name(name)}() -> int {
            return 21;
        }
    }
}

fn main() -> int {
    let answer = first() + second();
    printf("%d\n", answer);
    return answer == 42 ? 0 : 1;
}
