import c.stdio;

enum TokenType(token: char* = null, value: int = 10) {
    Identifier {},
    Number {},
    Plus { token: "+" },
    Minus { token: "-" },
    Asterisk { token: "*" },
    Slash { token: "/" },
    LeftParen { token: "(" },
    RightParen { token: ")" },
    EndOfFile {},
}

macro InspectTokenEnum(target: type) -> statements {
    @if(!target.is_data_enum) {
        Diagnostic.error(
            "InspectTokenEnum expects a data-backed enum, but received '{0}'.",
            target);
    }

    @if(target.is_data_enum) {
        printf("enum %s metadata:\n", @{target.name});

        printf("enum %s members:\n", @{target.name});

        @foreach member in target.members {
            printf("  %s: {\n", @{member.name});

            @foreach entry in member.data.entries {
                @if(entry.is_null) {
                    printf("    %s: <null>\n", @{entry.name});
                }

                @if(!entry.is_null && entry.type == int) {
                    printf("    %s: %d\n", @{entry.name}, @{entry.value});
                }

                @if(!entry.is_null && entry.type == Type.pointer(char)) {
                    printf("    %s: '%s'\n", @{entry.name}, @{entry.value});
                }
            }

            printf("  }\n");
        }
    }
}

fn main() -> int {
    use InspectTokenEnum(TokenType);
    return 0;
}
