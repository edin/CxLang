attribute export on fn {}
attribute optional on parameter {
    value: value;
}
attribute range on parameter {
    minimum: int;
    maximum: int;
}

public compile fn php_export_type_supported(value: type) -> bool {
    return value == i64
        || value == double
        || value == bool
        || value == StringView
        || value == StringBuilder;
}

public compile fn php_export_result_supported(value: type) -> bool {
    return value.is_named
        && value.name == "Result"
        && value.type_arguments.count == 2
        && (value.type_arguments[0] == i64
            || value.type_arguments[0] == StringBuilder)
        && value.type_arguments[1] == Error;
}

public compile fn php_export_return_supported(value: type) -> bool {
    return php_export_type_supported(value)
        || php_export_result_supported(value);
}

public compile fn php_export_type_mask(value: type) -> int {
    if (php_export_result_supported(value)) {
        return php_export_type_mask(value.type_arguments[0]);
    }
    if (value == i64) {
        return 16;
    }
    if (value == double) {
        return 32;
    }
    if (value == bool) {
        return 12;
    }
    if (value == StringView) {
        return 64;
    }
    if (value == StringBuilder) {
        return 64;
    }

    return 0;
}

public compile fn php_optional_default_kind(value: type) -> string {
    if (value == i64 || value == double) {
        return "integer";
    }
    if (value == bool) {
        return "boolean";
    }
    if (value == StringView) {
        return "string";
    }

    return "unsupported";
}

public macro PhpExport(function: declaration) -> declarations {
    @if(!php_export_return_supported(function.return_type)) {
        Diagnostic.error(
            "PhpExport does not support return type {1} on '{0}'.",
            function.name,
            function.return_type.display_name
        );
    }

    @let optional_parameters = [];
    @foreach parameter in function.parameters {
        @let optional = parameter.attribute("optional");
        @if(optional == null && optional_parameters.count > 0) {
            Diagnostic.error(
                parameter,
                "Required PHP parameter '{0}' on '{1}' cannot follow an optional parameter.",
                parameter.name,
                function.name
            );
        }
        @if(optional != null) {
            optional_parameters.add(parameter);

            @let expected_default_kind =
                php_optional_default_kind(parameter.type);
            @if(expected_default_kind == "unsupported") {
                Diagnostic.error(
                    parameter,
                    "optional does not support defaults for parameter '{0}' of type {1}.",
                    parameter.name,
                    parameter.type.display_name
                );
            }
            @if(expected_default_kind != "unsupported"
                && optional.value.kind != expected_default_kind) {
                Diagnostic.error(
                    parameter,
                    "optional on parameter '{0}' of type {1} requires a {2} default, but received {3}.",
                    parameter.name,
                    parameter.type.display_name,
                    expected_default_kind,
                    optional.value.kind
                );
            }
        }
        @if(!php_export_type_supported(parameter.type)) {
            Diagnostic.error(
                "PhpExport does not support parameter '{0}' of type {1}.",
                parameter.name,
                parameter.type.display_name
            );
        }
        @if(parameter.attribute("range") != null
            && parameter.type != i64) {
            Diagnostic.error(
                "range requires parameter '{0}' to have type i64, but it has type {1}.",
                parameter.name,
                parameter.type.display_name
            );
        }
    }

    fn @{as_name(concat("php_", function.name))}(
        execute_data: void*,
        return_value: ZendZval*
    ) -> void {
        let arguments: PhpArguments = PhpArguments.from(execute_data);

        @foreach parameter in function.parameters {
            @let optional = parameter.attribute("optional");
            @if(parameter.type == i64) {
                @if(optional == null) {
                    let @{as_name(parameter.name)}: i64 = 0;
                }
                @if(optional != null) {
                    let @{as_name(parameter.name)}: i64 = @{optional.value};
                }
            }
            @if(parameter.type == double) {
                @if(optional == null) {
                    let @{as_name(parameter.name)}: double = 0.0;
                }
                @if(optional != null) {
                    let @{as_name(parameter.name)}: double = @{optional.value};
                }
            }
            @if(parameter.type == bool) {
                @if(optional == null) {
                    let @{as_name(parameter.name)}: bool = false;
                }
                @if(optional != null) {
                    let @{as_name(parameter.name)}: bool = @{optional.value};
                }
            }
            @if(parameter.type == StringView) {
                @if(optional == null) {
                    let @{as_name(parameter.name)}: StringView = StringView.empty();
                }
                @if(optional != null) {
                    let @{as_name(parameter.name)}: StringView =
                        StringView.from_cstr(@{optional.value});
                }
            }
        }

        if (!arguments.expect_count(
            @{function.parameters.count - optional_parameters.count},
            @{function.parameters.count}
        )) {
            return;
        }

        @let parameter_index = 0;
        @foreach parameter in function.parameters {
            @let optional = parameter.attribute("optional");
            @if(optional == null) {
                if (!arguments.parse(
                    @{parameter_index},
                    &@{as_name(parameter.name)}
                )) {
                    return;
                }
            }
            @if(optional != null) {
                if (!arguments.parse_if_present(
                    @{parameter_index},
                    &@{as_name(parameter.name)}
                )) {
                    return;
                }
            }

            @let range = parameter.attribute("range");
            @if(range != null) {
                if (@{as_name(parameter.name)} < @{range.minimum}
                    || @{as_name(parameter.name)} > @{range.maximum}) {
                    PhpArguments.value_error(
                        @{parameter_index + 1},
                        "is outside the supported range"
                    );
                    return;
                }
            }
            parameter_index = parameter_index + 1;
        }

        @if(function.return_type == i64) {
            return_value.set_long(
                @{as_name(function.name)}(@{function.parameters})
            );
        }
        @if(function.return_type == double) {
            return_value.set_double(
                @{as_name(function.name)}(@{function.parameters})
            );
        }
        @if(function.return_type == bool) {
            return_value.set_bool(
                @{as_name(function.name)}(@{function.parameters})
            );
        }
        @if(function.return_type == StringView) {
            let result: StringView =
                @{as_name(function.name)}(@{function.parameters});
            return_value.set_string_copy(result.data, result.length);
        }
        @if(function.return_type == StringBuilder) {
            using result: StringBuilder =
                @{as_name(function.name)}(@{function.parameters});
            let view: StringView = result.as_view();
            return_value.set_string_copy(view.data, view.length);
        }
        @if(php_export_result_supported(function.return_type)
            && function.return_type.type_arguments[0] == i64) {
            let result: @{function.return_type} =
                @{as_name(function.name)}(@{function.parameters});
            if (result.is_error()) {
                PhpArguments.error(result.error.message);
                return;
            }

            return_value.set_long(result.value);
        }
        @if(php_export_result_supported(function.return_type)
            && function.return_type.type_arguments[0] == StringBuilder) {
            using result: @{function.return_type} =
                @{as_name(function.name)}(@{function.parameters});
            if (result.is_error()) {
                PhpArguments.error(result.error.message);
                return;
            }

            let view: StringView = result.value.as_view();
            return_value.set_string_copy(view.data, view.length);
        }
    }
}

public macro PhpArgInfos(
    function: declaration
) -> elements<ZendInternalArgInfo> {
    @let optional_parameters = [];
    @foreach parameter in function.parameters {
        @if(parameter.attribute("optional") != null) {
            optional_parameters.add(parameter);
        }
    }

    return {
        {
            (const char*)@{
                function.parameters.count - optional_parameters.count
            },
            {
                null,
                (u32)@{php_export_type_mask(function.return_type)}
            },
            null
        },
        @foreach parameter in function.parameters {
            @if(parameter.attribute("optional") == null) {
                {
                    @{parameter.name},
                    {
                        null,
                        (u32)@{php_export_type_mask(parameter.type)}
                    },
                    null
                },
            }
            @if(parameter.attribute("optional") != null) {
                {
                    @{parameter.name},
                    {
                        null,
                        (u32)@{php_export_type_mask(parameter.type)}
                    },
                    @{parameter.attribute("optional").value.display}
                },
            }
        }
    };
}

public macro PhpModule(
    module_name: expression,
    module_version: expression
) -> declarations {
    @let exports = [];

    @foreach function in module.functions {
        @if(function.attribute("export") != null) {
            exports.add(function);
        }
    }

    @foreach function in exports {
        use PhpExport(@{function.reference});
    }

    const cx_generated_arg_info: ZendInternalArgInfo[] = {
        @foreach function in exports {
            use PhpArgInfos(@{function.reference}),
        }
    };

    let cx_generated_functions:
        @{Type.array(ZendFunctionEntry, exports.count + 1)} = {};

    let cx_generated_module_entry: ZendModuleEntry = {
        (u16)sizeof(ZendModuleEntry),
        (u32)20250925,
        (u8)0,
        (u8)0,
        null,
        null,
        @{module_name},
        &cx_generated_functions[0],
        null,
        null,
        null,
        null,
        null,
        @{module_version},
        (usize)0,
        null,
        null,
        null,
        null,
        0,
        (u8)0,
        null,
        0,
        "API20250925,NTS"
    };

    fn get_module() -> ZendModuleEntry* {
        @let function_index = 0;
        @let arg_info_index = 0;
        @foreach function in exports {
            php_set_generated_function_entry(
                &cx_generated_functions[0],
                @{function_index},
                @{function.name},
                @{as_name(concat("php_", function.name))},
                &cx_generated_arg_info[0],
                @{arg_info_index},
                (u32)@{function.parameters.count}
            );

            arg_info_index = arg_info_index + function.parameters.count + 1;
            function_index = function_index + 1;
        }

        return &cx_generated_module_entry;
    }
}
