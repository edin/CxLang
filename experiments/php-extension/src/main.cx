@php_export
fn cx_answer() -> i64 {
    return 42;
}

@php_export
fn cx_greeting() -> StringView {
    return StringView.from_parts("Hello from CX", (usize)13);
}

@php_export
fn cx_repeat(
    value: StringView,
    @php_optional(value: 1, display: "1")
    @php_i64_range(minimum: 0, maximum: 1000000)
    count: i64
) -> StringBuilder {
    let output_length: usize = value.length * (usize)count;
    using result: StringBuilder = StringBuilder.with_capacity(output_length);
    let index: i64 = 0;

    while (index < count) {
        result.append_view(value);
        index += 1;
    }

    return result;
}

@php_export
fn cx_add(left: i64, right: i64) -> i64 {
    return left + right;
}

@php_export
fn cx_optional_sum(
    base: i64,
    @php_optional(value: 1, display: "1") first: i64,
    @php_optional(value: 2, display: "2") second: i64
) -> i64 {
    return base + first + second;
}

@php_export
fn cx_multiply(left: double, right: double) -> double {
    return left * right;
}

@php_export
fn cx_not(value: bool) -> bool {
    return !value;
}

@php_export
fn cx_weighted(count: i64, factor: double, enabled: bool) -> double {
    if (!enabled) {
        return 0.0;
    }

    return (double)count * factor;
}
