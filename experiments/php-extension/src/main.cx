@export
fn cx_answer() -> i64 {
    return 42;
}

@export
fn cx_greeting() -> StringView {
    return StringView.from_parts("Hello from CX", (usize)13);
}

@export
fn cx_repeat(
    value: StringView,
    @optional(value: 1)
    @range(minimum: 0, maximum: 1000000)
    count: i64
) -> StringBuilder {
    let output_length: usize = value.length * (usize)count;
    using result: StringBuilder = StringBuilder.with_capacity(output_length);
    let index: i64 = 0;

    while (index < count) {
        result.append_view(value);
        index += 1;
    }

    return result;
}

@export
fn cx_add(left: i64, right: i64) -> i64 {
    return left + right;
}

@export
fn cx_optional_sum(
    base: i64,
    @optional(value: 1) first: i64,
    @optional(value: 2) second: i64
) -> i64 {
    return base + first + second;
}

@export
fn cx_multiply(left: double, right: double) -> double {
    return left * right;
}

@export
fn cx_not(value: bool) -> bool {
    return !value;
}

@export
fn cx_weighted(count: i64, factor: double, enabled: bool) -> double {
    if (!enabled) {
        return 0.0;
    }

    return (double)count * factor;
}

@export
fn cx_checked_increment(value: i64) -> Result<i64, Error> {
    if (value < 0) {
        return Result.err<i64, Error>(Error.create(
            "cx_demo",
            1,
            "value must be non-negative"
        ));
    }

    return Result.ok<i64, Error>(value + 1);
}

@export
fn cx_checked_repeat(
    value: StringView,
    count: i64
) -> Result<StringBuilder, Error> {
    if (count < 0) {
        return Result.err<StringBuilder, Error>(Error.create(
            "cx_demo",
            2,
            "count must be non-negative"
        ));
    }

    let result: StringBuilder = StringBuilder.create();
    let index: i64 = 0;
    while (index < count) {
        if (!result.append_view(value)) {
            result.dispose();
            return Result.err<StringBuilder, Error>(Error.create(
                "cx_demo",
                3,
                "could not allocate repeated string"
            ));
        }

        index += 1;
    }

    return Result.ok<StringBuilder, Error>(result);
}

use PhpModule("cx_demo", "0.1.0");
