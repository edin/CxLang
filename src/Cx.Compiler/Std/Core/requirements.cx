module std.core;

public requires Equal<T> {
    fn operator ==(other: T) -> bool;
}

public requires Hash<T> {
    static fn hash(value: T) -> u64;
}

public requires Compare<T> {
    fn operator <=>(other: T) -> int;
}

public requires Disposable<T> {
    fn dispose() -> void;
}

static fn int.equals(left: int, right: int) -> bool {
    return left == right;
}

static fn int.hash(value: int) -> u64 {
    return (u64)value;
}

extension int {
    fn operator <=>(other: int) -> int {
        if (self < other) {
            return -1;
        }

        if (self > other) {
            return 1;
        }

        return 0;
    }
}

public fn equals(left: int, right: int) -> bool {
    return int.equals(left, right);
}

public fn hash(value: int) -> u64 {
    return int.hash(value);
}

test "int equal hash compare requirements" {
    expect_true(10 == 10);
    expect_false(10 == 11);
    expect_eq_u64((u64)42, int.hash(42));
    expect_eq_int(-1, 1 <=> 2);
    expect_eq_int(0, 2 <=> 2);
    expect_eq_int(1, 3 <=> 2);
}

test "string view equal and hash requirements" {
    let left: StringView = StringView.from_cstr("cx");
    let same: StringView = StringView.from_cstr("cx");
    let other: StringView = StringView.from_cstr("c");

    expect_true(left == same);
    expect_false(left == other);
    expect_eq_u64(StringView.hash(left), StringView.hash(same));
}
